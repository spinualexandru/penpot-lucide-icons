{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@penpot"
    ],
    "types": ["plugin-types"],
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    /* Off deliberately: the only JSON we import is lucide-static's 723 KB
       icon-nodes.json. With this on, tsc reads the file and infers a
       1756-property literal type for zero benefit. src/types/lucide-static.d.ts
       declares exactly the types we want instead; Vite still bundles it. */
    "resolveJsonModule": false,
    "isolatedModules": true,
    /* Makes tsc reject `import { SomeType }` that should be `import type`.
       Load-bearing: a value import from src/lib/messages into src/plugin.ts
       would make Rollup emit a shared chunk and break the Penpot sandbox. */
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
